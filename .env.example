# Your ESPN league ID -- from the league URL:
#   https://fantasy.espn.com/football/league?leagueId=123456
LEAGUE_ID=123456

# Only needed for PRIVATE leagues. Get these from your browser:
#   fantasy.espn.com -> DevTools -> Application -> Cookies -> https://fantasy.espn.com
ESPN_S2=
SWID=

# Optional: oldest season to attempt. Blank = probe backwards until ESPN 404s.
FIRST_SEASON=

# League rules
# ------------
# First season in which a team earns a second win each week for beating the
# league's median score (leave blank if your league does not do this).
MEDIAN_SCORING_FROM=

# Number of teams that make the playoffs is read from ESPN. Teams that miss the
# playoffs are ranked by regular-season record only -- consolation ("toilet
# bowl") results never change a final placing.
